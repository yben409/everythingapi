# Copy to .env and fill in. Never commit .env.
# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# SQLite in dev, Postgres in prod
DATABASE_URL=sqlite:///./agentpay.db

# Webhook id from the sandbox app's Webhooks section (needed to verify signatures)
PAYPAL_WEBHOOK_ID=
